    {
      "id": 25,
      "title": "RHR and HRV trend",
      "description": "RHR (left axis, bpm) and HRV RMSSD (right axis, ms). They typically move inversely: lower RHR and higher HRV indicate better cardiovascular fitness and recovery.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_HEALTHEX_POSTGRES}"
      },
      "targets": [
        {
          "rawSql": "SELECT rhr_date AS time, bpm AS \"RHR (bpm)\" FROM daily_rhr WHERE user_id = '$user_id' ORDER BY 1",
          "format": "time_series",
          "refId": "O"
        },
        {
          "rawSql": "SELECT hrv_date AS time, avg_hrv_ms AS \"HRV (ms)\" FROM daily_hrv WHERE user_id = '$user_id' ORDER BY 1",
          "format": "time_series",
          "refId": "P"
        }
      ],
