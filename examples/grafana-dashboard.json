    {
      "id": 31,
      "title": "Avg Bedtime (30d)",
      "description": "Average time falling asleep over the past 30 days, in Central European Time.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_HEALTHEX_POSTGRES}"
      },
      "targets": [
        {
          "rawSql": "WITH main_sessions AS (SELECT DISTINCT ON (civil_date) (start_time AT TIME ZONE '$tz')::time AS sleep_time FROM sleep_sessions WHERE user_id = '$user_id' AND civil_date >= CURRENT_DATE - INTERVAL '30 days' ORDER BY civil_date, minutes_asleep DESC) SELECT to_char((to_timestamp(AVG(CASE WHEN EXTRACT(HOUR FROM sleep_time) < 12 THEN EXTRACT(EPOCH FROM sleep_time) + 86400 ELSE EXTRACT(EPOCH FROM sleep_time) END)) AT TIME ZONE 'UTC')::time, 'HH24:MI') AS \"Bedtime\" FROM main_sessions",
          "format": "table",
          "refId": "Q"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": false,
        "cellHeight": "xl"
      },
      "transformations": []
    },
    {
